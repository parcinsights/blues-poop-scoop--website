# Copy to .env.local. Never commit real values.

# The one origin this build knows about. Drives canonical, OG, sitemap, and every schema @id.
NEXT_PUBLIC_SITE_URL=https://bluespoopscoop.com

# Set by Vercel automatically: "production" | "preview" | "development".
# Anything other than "production" serves Disallow: / and noindex.
# VERCEL_ENV=

# Lead sinks — server-only, never NEXT_PUBLIC_.
#
# GoHighLevel: the sub-account inbound webhook. Every lead goes here; it is what texts and emails
# the owner. Still unset — see lib/integrations.ts.
GHL_WEBHOOK_URL=

# Sweep&Go: Bearer token from their dashboard. /api/lead uses it to file leads whose zip falls
# OUTSIDE the service area. In-area leads have nowhere to go in Sweep&Go — they have no endpoint
# that creates one — so those go to GoHighLevel alone.
SWEEPANDGO_API_TOKEN=

# Their API host. Only set this to point the calls somewhere that is not the real CRM.
# SWEEPANDGO_API_BASE=https://openapi.sweepandgo.com

# Analytics (phase 7)
NEXT_PUBLIC_GA4_ID=

# The service-area map. A Google Cloud key with the MAPS STATIC API enabled and listed in the key's
# API restrictions — not the Maps JavaScript API, which is billed per load and ships a client
# library we do not want. The image is fetched by the browser, so it MUST carry an HTTP-referrer
# restriction locking it to the production domain; that is the only thing protecting it. Unset =
# no map, and the band renders its town list without one. See lib/maps.ts.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
