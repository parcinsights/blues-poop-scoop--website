# Copy to .env.local. Never commit real values.

# The one origin this build knows about. Drives canonical, OG, sitemap, and every schema @id.
NEXT_PUBLIC_SITE_URL=https://bluespoopscoop.com

# Set by Vercel automatically: "production" | "preview" | "development".
# Anything other than "production" serves Disallow: / and noindex.
# VERCEL_ENV=

# Lead sinks — server-only, never NEXT_PUBLIC_.
#
# GoHighLevel: the sub-account inbound webhook. Every lead from every form goes here, in one
# payload shape, and it is what texts and emails the owner. OPTIONAL — the real trigger url is the
# default in lib/integrations.ts and is the same on local, preview and production. Set this only to
# point an environment somewhere else.
GHL_WEBHOOK_URL=

# Sweep&Go: Bearer token from their dashboard. /api/lead uses it to file leads whose zip falls
# OUTSIDE the service area. In-area leads have nowhere to go in Sweep&Go — they have no endpoint
# that creates one — so those go to GoHighLevel alone.
SWEEPANDGO_API_TOKEN=

# Cloudflare Turnstile — the bot gate on both forms. Create the widget at
# dash.cloudflare.com → Turnstile → Add widget, Managed mode, with these hostnames:
#   bluespoopscoop.com, www.bluespoopscoop.com, localhost, 127.0.0.1
#
# Both blank = gate off: the forms still work and every submission is accepted with a warning in
# the log. That is deliberate — see lib/turnstile.ts. Fill them in to switch it on.
#
# The sitekey is public and ships in the browser bundle. The secret NEVER does.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: override which hostnames a token may be minted on. Defaults to the host of
# NEXT_PUBLIC_SITE_URL and its www twin, plus localhost off production. Set this only for a
# deployment served from some other domain. NEVER include localhost in a production value.
TURNSTILE_HOSTNAMES=

# Their API host. Only set this to point the calls somewhere that is not the real CRM.
# SWEEPANDGO_API_BASE=https://openapi.sweepandgo.com

# Analytics (phase 7)
NEXT_PUBLIC_GA4_ID=

# The service-area map. A Google Cloud key with the MAPS STATIC API enabled and listed in the key's
# API restrictions — not the Maps JavaScript API, which is billed per load and ships a client
# library we do not want. The image is fetched by the browser, so it MUST carry an HTTP-referrer
# restriction locking it to the production domain; that is the only thing protecting it. Unset =
# no map, and the band renders its town list without one. See lib/maps.ts.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
