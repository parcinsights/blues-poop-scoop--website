# Copy to .env.local. Never commit real values.

# The one origin this build knows about. Drives canonical, OG, sitemap, and every schema @id.
NEXT_PUBLIC_SITE_URL=https://bluespoopscoop.com

# Set by Vercel automatically: "production" | "preview" | "development".
# Anything other than "production" serves Disallow: / and noindex.
# VERCEL_ENV=

# Lead sinks (phase 5) — server-only, never NEXT_PUBLIC_.
GHL_WEBHOOK_URL=
SWEEPANDGO_API_TOKEN=

# Analytics (phase 7)
NEXT_PUBLIC_GA4_ID=
